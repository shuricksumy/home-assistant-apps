{
  "name": "Music Assistant Proxy",
  "version": "1.9.1",
  "slug": "music_assistant_proxy",
  "description": "Music Assistant running on its own hardware, in your Home Assistant sidebar",
  "url": "https://github.com/shuricksumy/home-assistant-apps",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "init": false,
  "ingress": true,
  "ingress_stream": true,
  "panel_icon": "mdi:music",
  "panel_title": "Music Assistant",
  "options": {
    "server_host": "192.168.1.11",
    "server_port": 8095,
    "ma_token": ""
  },
  "schema": {
    "server_host": "str",
    "server_port": "port",
    "ma_token": "password?"
  },
  "timeout": 30
}
