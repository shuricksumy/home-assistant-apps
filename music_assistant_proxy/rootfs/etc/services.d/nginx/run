#!/usr/bin/with-contenv bashio
# shellcheck shell=bash

# Get config values. server_host is accepted as a bare host, or as a full URL so
# that a Music Assistant published through a reverse proxy can be given as-is.
RAW_HOST=$(bashio::config 'server_host' | tr -d '[:space:]')
SERVER_PORT=$(bashio::config 'server_port')

SCHEME=http
case "${RAW_HOST}" in
    https://*) SCHEME=https; RAW_HOST=${RAW_HOST#https://} ;;
    http://*)  SCHEME=http;  RAW_HOST=${RAW_HOST#http://} ;;
esac
RAW_HOST=${RAW_HOST%%/*}

case "${RAW_HOST}" in
    \[*\]:*)  HOST=${RAW_HOST%:*};  PORT=${RAW_HOST##*:} ;;   # [::1]:8095
    \[*\])    HOST=${RAW_HOST};     PORT=${SERVER_PORT}  ;;   # [::1]
    *:*)      HOST=${RAW_HOST%%:*}; PORT=${RAW_HOST##*:} ;;   # host:8095
    *)        HOST=${RAW_HOST};     PORT=${SERVER_PORT}  ;;
esac

if [ -z "${HOST}" ]; then
    bashio::log.error "server_host is empty. Set it to the address of your Music Assistant server."
    sleep 10
    bashio::exit.nok
fi

export UPSTREAM="${SCHEME}://${HOST}:${PORT}"

# A reverse proxy routes on the Host header, so send the upstream's own name
# rather than the address the browser used. Default ports are left off, as a
# vhost match on "name:443" is not something every proxy handles.
if { [ "${SCHEME}" = https ] && [ "${PORT}" = 443 ]; } \
    || { [ "${SCHEME}" = http ] && [ "${PORT}" = 80 ]; }; then
    HOST_HEADER="${HOST}"
else
    HOST_HEADER="${HOST}:${PORT}"
fi

{
    printf 'proxy_set_header Host %s;\n' "${HOST_HEADER}"
    if [ "${SCHEME}" = https ]; then
        # Without SNI a name-based proxy cannot tell which certificate to serve.
        printf 'proxy_ssl_server_name on;\n'
        printf 'proxy_ssl_name %s;\n' "${HOST}"
    fi
} > /etc/nginx/upstream.conf
# 8099 is the Supervisor default for ingress_port, which is why config.json no
# longer sets it. Hardcoded rather than read from the Supervisor API so the addon
# does not need the hassio_api role; if that default ever changes, set
# ingress_port explicitly in config.json and match it here.
export INGRESS_PORT=8099

bashio::log.info "Starting Music Assistant Proxy..."
bashio::log.info "Upstream: ${UPSTREAM}"
bashio::log.info "Ingress port: ${INGRESS_PORT}"

# Render the config from the template on every boot, so changing the addon
# options actually takes effect. Never write back over the template itself.
envsubst '${UPSTREAM} ${INGRESS_PORT}' \
    < /etc/nginx/templates/nginx.conf.template \
    > /etc/nginx/nginx.conf

# Optional auto-login: drop a token straight into the page so nobody has to type
# credentials. Without this each person signs in once and the session is kept.
#
# Tokens are chosen per Home Assistant user. The Supervisor sets
# X-Remote-User-Name from the viewer's HA session on every ingress request, after
# stripping any copy the browser sent, so it is safe to key on. ma_users maps a
# username to that person's own token; ma_token, if set, covers everyone else.
#
# Two keys are written. "ma_access_token" is the one this MA reads on startup.
# "ma_access_token_connection" does not exist in this version and is inert here,
# but newer builds bind a saved token to a connection identity and refuse to
# restore it without a match, so it is written for them -- computed exactly as
# their createLocalConnectionIdentity does, from whatever URL served the page.

# Ask Music Assistant whether it accepts a token, so a bad one shows up here
# instead of as a login screen with no explanation. -k because nginx does not
# verify the upstream certificate either.
check_token() {
    local label=$1 token=$2 body code who
    body=$(mktemp)
    code=$(curl -s -k -o "${body}" -w '%{http_code}' -m 10 \
        -H "Authorization: Bearer ${token}" \
        "${UPSTREAM}/auth/me" || true)
    case "${code}" in
        200)
            who=$(jq -r '.username // .display_name // empty' "${body}" 2>/dev/null || true)
            bashio::log.info "${label}: token accepted${who:+ (Music Assistant user \"${who}\")}"
            ;;
        000|"")
            bashio::log.warning "${label}: could not reach Music Assistant at ${UPSTREAM} to verify the token; using it anyway."
            ;;
        *)
            bashio::log.error "${label}: Music Assistant rejected the token (HTTP ${code})."
            bashio::log.error "${label}: create a fresh long-lived token in Music Assistant and paste it in."
            ;;
    esac
    rm -f "${body}"
}

# Tokens and usernames are written into nginx config and a script, so accept
# only characters that need no quoting in either. Tokens are usually pasted,
# so stray whitespace is stripped first: a trailing space silently invalidates
# a token and is impossible to see.
TOKEN_RE='^[A-Za-z0-9._-]+$'
USER_RE='^[A-Za-z0-9._@+-]+$'

FALLBACK_TOKEN=""
if bashio::config.has_value 'ma_token'; then
    FALLBACK_TOKEN=$(bashio::config 'ma_token' | tr -d '[:space:]')
    if [[ ! "${FALLBACK_TOKEN}" =~ ${TOKEN_RE} ]]; then
        bashio::log.error "ma_token contains unexpected characters; ignoring it."
        FALLBACK_TOKEN=""
    else
        check_token "ma_token (everyone not in ma_users)" "${FALLBACK_TOKEN}"
        bashio::log.warning "ma_token is given to every Home Assistant user not listed in ma_users,"
        bashio::log.warning "and anyone it is given to can read it from the page. Prefer ma_users."
    fi
fi

USER_COUNT=0
{
    # shellcheck disable=SC2016 # nginx variables, not shell ones
    printf 'map $http_x_remote_user_name $ma_seed_token {\n'
    printf '    default "%s";\n' "${FALLBACK_TOKEN}"
} > /etc/nginx/users_map.conf

declare -A SEEN_USERS=()
ENTRIES=$(bashio::config 'ma_users|length' 2>/dev/null || echo 0)
for ((i = 0; i < ENTRIES; i++)); do
    HA_USER=$(bashio::config "ma_users[${i}].ha_user" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
    USER_TOKEN=$(bashio::config "ma_users[${i}].ma_token" | tr -d '[:space:]')

    if [[ ! "${HA_USER}" =~ ${USER_RE} ]]; then
        bashio::log.error "ma_users entry $((i + 1)): \"${HA_USER}\" is not a valid Home Assistant username; skipping."
        continue
    fi
    if [[ -n "${SEEN_USERS[${HA_USER}]:-}" ]]; then
        bashio::log.error "ma_users: ${HA_USER} is listed more than once; using the first entry."
        continue
    fi
    if [[ ! "${USER_TOKEN}" =~ ${TOKEN_RE} ]]; then
        bashio::log.error "ma_users: the token for ${HA_USER} is empty or has unexpected characters; skipping."
        continue
    fi

    SEEN_USERS[${HA_USER}]=1
    check_token "ma_users: ${HA_USER}" "${USER_TOKEN}"
    printf '    "%s" "%s";\n' "${HA_USER}" "${USER_TOKEN}" >> /etc/nginx/users_map.conf
    USER_COUNT=$((USER_COUNT + 1))
done
printf '}\n' >> /etc/nginx/users_map.conf

# The script runs on every page load. With a token for this viewer it seeds the
# session and marks it as seeded. Without one, it removes only a session this
# proxy seeded earlier -- so on a shared browser the next person does not
# inherit someone else's account -- and leaves a session they signed into
# themselves alone.
: > /etc/nginx/inject.conf
if [ -n "${FALLBACK_TOKEN}" ] || [ "${USER_COUNT}" -gt 0 ]; then
    {
        printf "sub_filter '</head>' '<script>(function(){try{var t=\"\$ma_seed_token\";"
        printf 'var s=localStorage;'
        printf 'if(t){'
        printf 'var p=location.pathname;while(p.length&&p.charAt(p.length-1)==="/"){p=p.slice(0,-1);}'
        printf 's.setItem("ma_access_token",t);'
        printf 's.setItem("ma_access_token_connection","local:"+location.protocol+"//"+location.host+p);'
        printf 's.setItem("ma_proxy_seeded","1");'
        printf '}else if(s.getItem("ma_proxy_seeded")){'
        printf 's.removeItem("ma_access_token");s.removeItem("ma_access_token_connection");s.removeItem("ma_proxy_seeded");'
        printf '}'
        printf "}catch(e){}})();</script></head>';\n"
    } > /etc/nginx/inject.conf
    bashio::log.info "Auto-login enabled for ${USER_COUNT} mapped user(s)${FALLBACK_TOKEN:+, plus ma_token for everyone else}"
else
    bashio::log.info "No tokens set; each person signs in once and the session is kept"
fi

# Create required directories
mkdir -p /var/log/nginx /var/lib/nginx/tmp
chown nginx:nginx /var/lib/nginx/tmp

# Fail loudly on a bad config rather than looping on a restart with no reason.
if ! nginx -t; then
    bashio::log.error "Nginx rejected the generated configuration (shown above)."
    bashio::log.error "Check server_host and server_port; server_host may be a host or a full URL."
    # Slow the s6 restart loop so the real error stays readable in the log.
    sleep 10
    bashio::exit.nok
fi

bashio::log.info "Starting Nginx..."
exec 2>&1
exec nginx -g 'daemon off;'
