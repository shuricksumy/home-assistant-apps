worker_processes 1;
pid /var/run/nginx.pid;
error_log /proc/1/fd/2 info;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /proc/1/fd/1 combined;

    sendfile on;
    tcp_nopush on;
    server_tokens off;

    # Rewriting a response means asking the upstream not to compress it, so
    # compress it again here rather than shipping the bundle uncompressed.
    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/html text/javascript application/javascript application/json;

    # Music Assistant streams audio and artwork; never buffer or cap it.
    client_max_body_size 0;
    proxy_buffering off;
    proxy_request_buffering off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen ${INGRESS_PORT} default_server;

        # MA's frontend registers a service worker that precaches the app shell,
        # answering navigations from Cache Storage without ever reaching this
        # proxy -- which would strand the rewrites below. Replace it with one
        # that registers and claims normally but installs no fetch handler, so
        # every request goes to the network.
        #
        # It must stay registered rather than unregister itself: the app awaits
        # navigator.serviceWorker.ready with no timeout and then waits for a
        # controller, both behind the call that opens the API connection. A
        # worker that removes itself leaves those awaits racing a registration
        # that is disappearing. It also answers the set-remote-mode handshake,
        # which otherwise stalls the app for its full two second timeout.
        #
        # It deliberately does not clear Cache Storage: under ingress that origin
        # is shared with Home Assistant's own frontend, so deleting caches would
        # take HA's PWA cache with it. With no fetch handler the stale entries
        # are simply never consulted.
        location = /sw.js {
            default_type text/javascript;
            add_header Cache-Control "no-store" always;
            return 200 'self.addEventListener("install",function(){self.skipWaiting();});self.addEventListener("activate",function(e){e.waitUntil(self.clients.claim());});self.addEventListener("message",function(e){var d=e.data&&e.data.type;if(d==="set-remote-mode"&&e.source&&e.source.postMessage){e.source.postMessage({type:"remote-mode-ack"});}});';
        }

        # Music Assistant decides it is running as a Home Assistant add-on purely
        # from the URL containing /hassio_ingress/. It then authenticates through
        # ingress headers and never calls authenticateWithToken, so the stored
        # token is unreachable. A server reached over this proxy cannot satisfy
        # that check -- MA verifies it at socket level, on an ingress port a
        # remote server does not even bind -- so the UI dead-ends on "Failed to
        # authenticate via Home Assistant Ingress" and deliberately never offers
        # the login form.
        #
        # Neutralising the check puts the normal token/login path back in reach.
        # Fixed upstream by frontend #2216 ("Fix login behind Home Assistant
        # ingress"), which is not in any released server build yet; drop this
        # once a release carries it.
        # Served under a renamed prefix, rewritten into the page, so a browser
        # holding the unpatched bundle cannot revalidate its way back to it --
        # MA sends no Cache-Control on assets, only a validator. Renaming the
        # directory rather than adding a query keeps every module in one URL
        # namespace: relative imports inside the bundle resolve back into this
        # same prefix, so nothing is loaded twice under two identities.
        location /assets-mp1/ {
            proxy_pass http://${SERVER_HOST}:${SERVER_PORT}/assets/;
            include /etc/nginx/proxy_common.conf;

            # sub_filter cannot match a compressed body.
            proxy_set_header Accept-Encoding "";

            sub_filter_types text/javascript application/javascript;
            sub_filter_once off;
            sub_filter 'window.location.pathname.includes("/hassio_ingress/")' 'false';
        }

        # The SPA entrypoint, and the only response the auto-login script is
        # injected into. MA serves it from "/" but a direct /index.html request
        # must get the same treatment.
        location = / {
            proxy_pass http://${SERVER_HOST}:${SERVER_PORT};
            include /etc/nginx/proxy_common.conf;
            include /etc/nginx/html_entry.conf;
        }

        location = /index.html {
            proxy_pass http://${SERVER_HOST}:${SERVER_PORT};
            include /etc/nginx/proxy_common.conf;
            include /etc/nginx/html_entry.conf;
        }

        location / {
            proxy_pass http://${SERVER_HOST}:${SERVER_PORT};
            include /etc/nginx/proxy_common.conf;
        }
    }
}
