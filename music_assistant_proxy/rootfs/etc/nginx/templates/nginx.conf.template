worker_processes 1;
pid /var/run/nginx.pid;
error_log /proc/1/fd/2 info;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /proc/1/fd/1 combined;

    sendfile on;
    tcp_nopush on;
    server_tokens off;

    # Music Assistant streams audio and artwork; never buffer or cap it.
    client_max_body_size 0;
    proxy_buffering off;
    proxy_request_buffering off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen ${INGRESS_PORT} default_server;

        location / {
            proxy_pass http://${SERVER_HOST}:${SERVER_PORT};

            # Standard headers. X-Ingress-Path is passed through untouched by
            # nginx, which is how MA learns the base path it is served under.
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # WebSocket support (/ws is MA's primary API channel)
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # MA's websocket heartbeat is 30s; nginx's 60s default sits right on
            # the edge and causes idle disconnects. Give it plenty of room.
            proxy_connect_timeout 15s;
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;

            # Optional auto-login seed (generated at boot from the ma_token option).
            include /etc/nginx/inject.conf;
        }
    }
}
