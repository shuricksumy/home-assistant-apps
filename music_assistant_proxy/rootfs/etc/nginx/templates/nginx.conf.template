worker_processes 1;
pid /var/run/nginx.pid;
error_log /proc/1/fd/2 info;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /proc/1/fd/1 combined;

    sendfile on;
    tcp_nopush on;
    server_tokens off;

    # Music Assistant streams audio and artwork; never buffer or cap it.
    client_max_body_size 0;
    proxy_buffering off;
    proxy_request_buffering off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen ${INGRESS_PORT} default_server;

        # Service worker handling. Written at boot; empty unless auto-login is on.
        include /etc/nginx/sw.conf;

        # The SPA entrypoint, and the only response the auto-login script is
        # injected into. MA serves it from "/" but a direct /index.html request
        # must get the same treatment.
        location = / {
            proxy_pass http://${SERVER_HOST}:${SERVER_PORT};
            include /etc/nginx/proxy_common.conf;
            include /etc/nginx/html_entry.conf;
        }

        location = /index.html {
            proxy_pass http://${SERVER_HOST}:${SERVER_PORT};
            include /etc/nginx/proxy_common.conf;
            include /etc/nginx/html_entry.conf;
        }

        location / {
            proxy_pass http://${SERVER_HOST}:${SERVER_PORT};
            include /etc/nginx/proxy_common.conf;
        }
    }
}
