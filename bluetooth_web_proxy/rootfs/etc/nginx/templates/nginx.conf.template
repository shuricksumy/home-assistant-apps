worker_processes 1;
pid /var/run/nginx.pid;
error_log /proc/1/fd/2 info;

events {
    worker_connections 1024;
}

http {
    # Nothing is served from disk here; every response is proxied and carries
    # the upstream's own Content-Type, so mime.types and sendfile have nothing
    # to act on.
    access_log /proc/1/fd/1 combined;

    server_tokens off;

    # No response rewriting happens in this proxy, so bodies reach the browser
    # exactly as the upstream compressed them.
    client_max_body_size 0;
    proxy_buffering off;
    proxy_request_buffering off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen ${INGRESS_PORT} default_server;

        # One location and no rewriting, unlike the Music Assistant proxy next
        # door. That one has to patch an SPA it does not control; this panel
        # resolves its API calls relative to the document, so it lands correctly
        # under the /api/hassio_ingress/<token>/ prefix with nothing to fix up.
        location / {
            proxy_pass ${UPSTREAM};
            include /etc/nginx/proxy_common.conf;
        }
    }
}
