{
  "name": "Frigate Yard Stats Proxy",
  "version": "1.0.1",
  "slug": "frigate_yard_stats_proxy",
  "description": "Ingress proxy to a Frigate Yard Stats report UI running elsewhere",
  "url": "https://github.com/shuricksumy/home-assistant-apps",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "init": false,
  "ingress": true,
  "ingress_stream": true,
  "panel_icon": "mdi:cctv",
  "panel_title": "Yard Stats",
  "options": {
    "server_host": "192.168.1.20",
    "server_port": 8080,
    "api_key": ""
  },
  "schema": {
    "server_host": "str",
    "server_port": "port",
    "api_key": "password?"
  },
  "timeout": 30
}
